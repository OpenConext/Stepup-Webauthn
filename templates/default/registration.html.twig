
{% extends 'base.html.twig' %}

{% block body %}
    <h2>{{ 'registration.sub_title'|trans }}</h2>

    <form id="form"
            {{ stimulus_controller('@web-auth/registration',
                {
                    resultUrl: path('webauthn.controller.security.main.creation.result'),
                    optionsUrl: path('webauthn.controller.security.main.creation.options'),
                    successRedirectUri: path('app_identity_registration')
                }
            ) }}
    >
        <span>{{ 'status.registration_initial'|trans }}</span>

        <input
                type="hidden"
                name="username"
                id="username"
                value="{{ name }}"
        >
        <input
                type="hidden"
                name="displayName"
                id="inputDisplayName"
                value="{{ displayName }}"
        >
        <button
                type="button"
                id="registerButton"
                {{ stimulus_action('@web-auth/registration', 'register') }}
                hidden
        >

        </button>
    </form>

    {% include 'partial/error_table.html.twig' with
        {
            'timestamp': 'timestamp',
            'hostname': 'hostname',
            'requestId': 'requestId',
            'errorMessage': 'errorMessage',
            'sari': 'sari',
            'userAgent': 'userAgent',
            'ipAddress': 'ipAddress',
        }
    %}

    <script>
        (function () {
            const setText = (id, value) => {
                const el = document.getElementById(id);
                if (el) el.textContent = value ?? '';
            };

            const showErrors = () => {
                const el = document.getElementById('errorData');
                el.classList.remove('hidden');
            };

            const handleFailure = (evt) => {
                const detail = evt.detail || {};
                const error = detail.error;
                const response = detail.response;
                const msg =
                    (error && (error.message || String(error))) ||
                    (response && `Registration rejected by server (HTTP ${response.status})`) ||
                    'Registration failed';

                console.error('[webauthn] failure event:', evt.type, detail);
                if (response) {
                    response.clone().text().then(body => console.error('[webauthn] server response body:', body));
                }

                setText('title', '{{ "status.webauthn_not_supported_or_failed"|trans }}');
                setText('errorMessage', msg);
                setText('timestamp', new Date().toISOString());

                showErrors();
            };

            [
                'webauthn:registration:options:request',
                'webauthn:registration:options:success',
                'webauthn:registration:credential',
                'webauthn:registration:verify:request',
                'webauthn:registration:verify:success',
                'webauthn:unsupported',
            ].forEach(name => window.addEventListener(name, evt => console.log('[webauthn]', evt.type, evt.detail), true));

            window.addEventListener('webauthn:registration:error', handleFailure, true);
            window.addEventListener('webauthn:registration:verify:error', handleFailure, true);
            window.addEventListener('webauthn:registration:options:error', handleFailure, true);

            // Trigger registration once the Stimulus controller has connected.
            // Using the connect event guarantees the action handler is in place.
            window.addEventListener('webauthn:registration:connect', () => {
                document.getElementById('registerButton').click();
            }, { once: true });
        })();
    </script>

    {% include 'default/variables.twig' %}

{% endblock %}
