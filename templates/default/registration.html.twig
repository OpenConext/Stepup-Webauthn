
{% extends 'base.html.twig' %}

{% block body %}
    <h2>{{ 'registration.sub_title'|trans }}</h2>

    {% if serviceName %}
        <p>{{ 'registration.service_name'|trans({'%serviceName%': serviceName}) }}</p>
    {% endif %}

    <form id="form"
            {{ stimulus_controller('@web-auth/registration',
                {
                    resultUrl: path('webauthn.controller.security.main.creation.result'),
                    optionsUrl: path('webauthn.controller.security.main.creation.options'),
                    successRedirectUri: path('app_identity_registration')
                }
            ) }}
    >
        <span>{{ 'status.registration_initial'|trans }}</span>

        <input
                type="hidden"
                name="username"
                id="username"
                value="{{ name }}"
        >
        <input
                type="hidden"
                name="displayName"
                id="inputDisplayName"
                value="{{ displayName }}"
        >
        <button
                type="button"
                id="registerButton"
                {{ stimulus_action('@web-auth/registration', 'register') }}
                hidden
        >

        </button>
    </form>

    {% include 'partial/error_table.html.twig' with
        {
            'timestamp': 'timestamp',
            'hostname': 'hostname',
            'requestId': 'requestId',
            'errorMessage': 'errorMessage',
            'sari': 'sari',
            'userAgent': 'userAgent',
            'ipAddress': 'ipAddress',
        }
    %}

    <script>
        (function () {
            const setText = (id, value) => {
                const el = document.getElementById(id);
                if (el) el.textContent = value ?? '';
            };

            const showErrors = () => {
                const el = document.getElementById('errorData');
                el.classList.remove('hidden');
            };

            const handleFailure = async (evt) => {
                const detail = evt.detail || {};
                const error = detail.error;
                const response = detail.response;

                let msg = (error && (error.message || String(error))) || 'Registration failed';

                if (response) {
                    try {
                        const body = await response.clone().json();
                        if (body.errorCode === 'backup_eligible_rejected') {
                            msg = '{{ "status.passkey_not_accepted"|trans }}';
                        } else {
                            msg = body.errorMessage || `Registration rejected by server (HTTP ${response.status})`;
                        }
                    } catch {
                        msg = `Registration rejected by server (HTTP ${response.status})`;
                    }
                }

                setText('title', '{{ "status.webauthn_not_supported_or_failed"|trans }}');
                setText('errorMessage', msg);
                setText('timestamp', new Date().toISOString());

                showErrors();
            };

            window.addEventListener('webauthn:registration:error', handleFailure, true);
            window.addEventListener('webauthn:registration:verify:error', handleFailure, true);
            window.addEventListener('webauthn:registration:options:error', handleFailure, true);

            // Guard against Stimulus connecting before this script runs, then fall back to the connect event.
            const registerBtn = document.getElementById('registerButton');
            if (!registerBtn.hidden) {
                registerBtn.click();
            } else {
                window.addEventListener('webauthn:registration:connect', () => registerBtn.click(), { once: true });
            }
        })();
    </script>

    {% include 'default/variables.twig' %}

{% endblock %}
