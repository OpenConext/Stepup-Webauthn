{% extends 'base.html.twig' %}

{% block body %}
    <h2>{{ 'authentication.sub_title'|trans }}</h2>

    <form id="form"
        {{ stimulus_controller('@web-auth/authentication',
                {
                    successRedirectUri: path('app_identity_authentication'),
                    resultUrl: path('webauthn.controller.security.main.request.result'),
                    optionsUrl: path('webauthn.controller.security.main.request.options')
                }
            ) }}
    >

        <span>{{ 'status.authentication_initial'|trans }}</span>

        <input
                type="hidden"
                name="username"
                id="inputUsername"
                value="{{ nameId }}"
                class="form-control block w-full px-4 py-2 text-xl font-normal text-gray-700 bg-white bg-clip-padding border border-solid border-gray-300 rounded transition ease-in-out m-0 focus:text-gray-700 focus:bg-white focus:border-blue-600 focus:outline-none"
                autocomplete="username webauthn"
        />

        <button id="authenticationButton"
                type="button"
                {{ stimulus_action('@web-auth/authentication', 'authenticate') }}
                hidden>
        </button>
    </form>


    {%  include 'partial/error_table.html.twig' with
        {
            'timestamp': 'timestamp',
            'hostname': 'hostname',
            'requestId': 'requestId',
            'errorMessage': 'errorMessage',
            'sari': 'sari',
            'userAgent': 'userAgent',
            'ipAddress': 'ipAddress',
        } %}

    <script>
        (function () {
            const setText = (id, value) => {
                const el = document.getElementById(id);
                if (el) el.textContent = value ?? '';
            };

            const showErrors = () => {
                const el = document.getElementById('errorData');
                el.classList.remove('hidden');
            };

            const handleFailure = (evt) => {
                const detail = evt.detail || {};
                const error = detail.error;
                const response = detail.response;
                const msg =
                    (error && (error.message || String(error))) ||
                    (response && `Authentication rejected by server (HTTP ${response.status})`) ||
                    'Authentication failed';

                setText('errorMessage', msg);
                setText('timestamp', new Date().toISOString());

                showErrors();
            };

            window.addEventListener('webauthn:authentication:error', handleFailure, true);
            window.addEventListener('webauthn:authentication:verify:error', handleFailure, true);
            window.addEventListener('webauthn:authentication:options:error', handleFailure, true);

            // Trigger authentication once the Stimulus controller has connected.
            window.addEventListener('webauthn:authentication:connect', () => {
                document.getElementById('authenticationButton').click();
            }, { once: true });
        })();
    </script>

    {% include 'default/variables.twig' %}

{% endblock %}
